# ====================== DIAGNOSTIC .htaccess ======================
# Last Updated: June 2026

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Remove www
    RewriteCond %{HTTP_HOST} ^www\.thevictorias\.com\.ng [NC]
    RewriteRule ^(.*)$ https://thevictorias.com.ng/$1 [R=301,L]

    # ==================== BUS ROUTING - SIMPLE & AGGRESSIVE ====================
    # This should catch /bus/anything
    RewriteRule ^bus/([^/]+)/?$ /bus/index.html [L,QSA]

    # Admin
    RewriteRule ^bus/admin/?$ /bus/admin.html [L,QSA]

    # Block sensitive files
    RewriteRule ^(\.htaccess|\.env|\.git) - [F,L]

    Options -Indexes
</IfModule>

# Basic Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always unset Server
    Header always unset X-Powered-By
</IfModule>

# Temporary Debug CSP (very permissive)
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src * 'unsafe-inline' 'unsafe-eval'; script-src * 'unsafe-inline'
    'unsafe-eval'; style-src * 'unsafe-inline'; img-src * data:; connect-src *;"
</IfModule>

# ====================== END ======================