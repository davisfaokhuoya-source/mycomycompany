/*
  # === Security Headers - Advanced Configuration (Big-Tech Style) ===

  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

  # Modern Cross-Origin Isolation Headers (used by X, Facebook, etc.)
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

  # Strong Permissions Policy (Facebook-style lockdown)
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), vr=(), xr-spatial-tracking=(), interest-cohort=(), autoplay=(), encrypted-media=(), fullscreen=(), midi=(), speaker-selection=(), display-capture=()

  # === Advanced CSP (Balanced but much stricter) ===
  Content-Security-Policy: default-src 'self';
    script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://script.google.com https://connect.facebook.net https://apis.google.com;
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com;
    font-src 'self' data: https://fonts.gstatic.com;
    img-src 'self' data: https: blob:;
    connect-src 'self' https://script.google.com https://thevictorias.com.ng;
    frame-src 'self' https://docs.google.com https://www.google.com https://accounts.google.com;
    object-src 'none';
    base-uri 'self';
    form-action 'self' https:;
    upgrade-insecure-requests;
    block-all-mixed-content;
    sandbox allow-forms allow-scripts allow-top-navigation-by-user-activation;